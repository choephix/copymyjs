---
interface Props {
  component: string;
  namedExport?: string;
}

// const LABEL_TEXT = 'Try it here';
const LABEL_TEXT = 'Live Demo';

const { component, namedExport } = Astro.props;
---

<div class='example-container mt-6'>
  <div class='relative flex flex-col'>
    <div
      class='z-10 self-center px-3 py-0.5 -mb-px text-xs font-medium text-white/70 bg-[#212f4d] 
      border-t border-x border-gray-700 rounded-t-lg select-none'
    >
      {LABEL_TEXT}
    </div>
    <div
      class='example-content border border-gray-700 rounded overflow-hidden bg-[#212f4d] min-h-[200px]'
      data-example={component}
      data-named-export={namedExport}
    >
    </div>
  </div>
</div>

<script>
  type ExampleRunner = (container: HTMLElement) => void | Promise<void>;
  type ExampleModule = Record<string, unknown>;

  const exampleModules = import.meta.glob<ExampleModule>(
    '../examples/**/*.ts'
  );

  const isExampleRunner = (value: unknown): value is ExampleRunner =>
    typeof value === 'function';

  const getErrorMessage = (error: unknown) =>
    error instanceof Error ? error.message : String(error);

  const renderExampleError = (container: HTMLElement, message: string) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'p-4 bg-red-900/50 border border-red-500 rounded';

    const text = document.createElement('p');
    text.className = 'text-red-200';
    text.textContent = `Failed to load example: ${message}`;

    wrapper.appendChild(text);
    container.replaceChildren(wrapper);
  };

  const loadExample = async (
    container: HTMLElement,
    componentName: string,
    namedExport?: string
  ) => {
    try {
      const modulePath = `../examples/${componentName}.ts`;
      const importExample = exampleModules[modulePath];

      if (!importExample) {
        throw new Error(`Example module not found: ${componentName}`);
      }

      const module = await importExample();
      const exportName = namedExport || 'default';
      const runner = module[exportName];

      if (!isExampleRunner(runner)) {
        throw new Error(`Example export not found: ${exportName}`);
      }

      await runner(container);
    } catch (error) {
      console.error('💥 Failed to load example:', error);
      renderExampleError(container, getErrorMessage(error));
    }
  };

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const container =
          entry.target.querySelector<HTMLDivElement>('.example-content');
        const componentName = container?.dataset.example;
        const namedExport = container?.dataset.namedExport;

        if (container && componentName) {
          loadExample(container, componentName, namedExport);
          observer.unobserve(entry.target);
        }
      }
    });
  });

  document.querySelectorAll('.example-container').forEach(el => {
    observer.observe(el);
  });
</script>
